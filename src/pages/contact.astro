---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Request a free estimate — demo" description="Try an accessible estimate form demonstration. No information is sent, stored, or used to contact you."><section class="section contact-layout"><div class="contact-copy"><p class="eyebrow">LET’S START WITH YOUR VISION</p><h1>Something beautiful<br/><em>starts here.</em></h1><p>Tell us a little about the outdoor space you have in mind.</p><div class="demo-box"><strong>This is a demo. Please use sample details.</strong><p>No request will be sent. This form has no backend, saves no data, and will not trigger a call or email.</p></div><p class="eyebrow">WHAT A REAL CONSULTATION COULD COVER</p><ol class="contact-steps"><li>Your ideas and how you use your space</li><li>Site conditions, scope, and material options</li><li>Budget, timing, and a clear next step</li></ol><a class="under-link" href="/privacy/">Privacy & demo details ↗</a></div><form id="estimate-form" onsubmit="return false" aria-describedby="form-note"><h2>Request Free Estimate</h2><p id="form-note">Demo only · Required fields are marked *</p><div class="form-row"><label>Full name *<input required maxlength="100" autocomplete="off" name="name" placeholder="Alex Sample"/></label><label>Email address *<input required type="email" maxlength="150" autocomplete="off" name="email" placeholder="alex@example.com"/></label></div><div class="form-row"><label>ZIP code *<input required pattern="[0-9]{5}" inputmode="numeric" maxlength="5" name="zip" placeholder="12345" title="Enter a five-digit U.S. ZIP code"/></label><label>Project interest *<select name="service" required><option value="">Select a service</option><option value="landscape">Landscape design</option><option value="hardscape">Hardscaping</option><option value="outdoor">Outdoor living</option><option value="complete">A complete transformation</option></select></label></div><div class="form-row"><label>Planning budget<select name="budget"><option value="">Not sure yet</option><option>Under $25,000</option><option>$25,000–$75,000</option><option>$75,000+</option></select></label><label>Ideal timing<select name="timing"><option>Exploring possibilities</option><option>Within 3 months</option><option>3–6 months</option><option>6+ months</option></select></label></div><label>Tell us about your space *<textarea name="message" required minlength="10" maxlength="2000" rows="4" placeholder="A sample project: a quiet patio with space to gather..."></textarea></label><label class="checkbox"><input type="checkbox" required/> <span>I understand this is a demo and no estimate request will be sent. *</span></label><button id="submit-demo" class="button" type="submit" disabled>Preview estimate request <span aria-hidden="true">↗</span></button><noscript><p>This demo needs JavaScript to preview a request. No information will be submitted.</p></noscript><p class="caption">No obligation. No submission. No follow-up.</p><div id="form-result" class="form-result" role="status" aria-live="polite" tabindex="-1" hidden></div></form></section></Layout>
<script>
const form=document.querySelector<HTMLFormElement>('#estimate-form');
const submit=document.querySelector<HTMLButtonElement>('#submit-demo');if(submit)submit.disabled=false;
const service=new URLSearchParams(location.search).get('service');const select=form?.querySelector<HTMLSelectElement>('[name="service"]');if(select&&service&&['landscape','hardscape','outdoor'].includes(service))select.value=service;
form?.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const result=document.querySelector<HTMLElement>('#form-result');if(result){result.hidden=false;result.textContent='Demo complete. Your sample request passed validation. Nothing was sent or saved, and nobody will contact you.';result.focus();}form.reset();});
</script>
