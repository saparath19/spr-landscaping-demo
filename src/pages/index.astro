---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import CTA from '../components/CTA.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import {services} from '../data/site';
---
<Layout title="Landscapes for a life well lived" description="A premium landscaping and hardscaping website concept by SPR Web Studio. Explore a fictional design-build business, sample projects, and a private estimate demo.">
<section class="hero hero-v2" aria-labelledby="home-hero-title">
  <Photo class="hero-photo" name="garden" alt="A garden with layered flowering borders and a winding planted path — licensed stock inspiration" eager/>
  <div class="hero-shade"></div>
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="hero-copy">
    <p class="eyebrow">A MORE THOUGHTFUL WAY TO LIVE OUTSIDE</p>
    <h1 id="home-hero-title">Your outdoors.<br/><em>Reimagined.</em></h1>
    <p>Landscape design, enduring stonework, and spaces that make every day feel a little more extraordinary.</p>
    <div class="hero-actions">
      <a class="button light" href="/contact/">Explore the estimate demo <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="/projects/">View design concepts <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <aside class="hero-editorial" aria-label="Hardscape design inspiration">
    <Photo class="hero-editorial-photo" name="terrace" alt="Stone terrace with outdoor dining — licensed stock inspiration"/>
    <div class="hero-editorial-caption"><span>02 / THE MATERIAL STORY</span><strong>Made to live in.</strong></div>
  </aside>
  <div class="hero-bottom"><span>FICTIONAL CONCEPT · CURATED DESIGN INSPIRATION</span><a href="#introduction">EXPLORE THE EXPERIENCE <span aria-hidden="true">↓</span></a></div>
</section>
<div class="service-ribbon" aria-label="Design priorities"><span>Beautiful to come home to.</span><span>Built around how you live.</span><span>Inspired by the outdoors.</span></div>
<section class="section intro" id="introduction"><p class="eyebrow">A NATURAL EXTENSION OF HOME</p><div><h2>Good design doesn’t stop<br/>at the <em>back door.</em></h2><div class="intro-bottom"><p>A great outdoor space doesn't just look beautiful. It makes everyday moments easier to enjoy — from that first morning coffee to the last conversation of the evening. Explore how the pieces could come together.</p><a class="under-link" href="/about/">Discover our approach <span aria-hidden="true">↗</span></a></div></div></section>
<section class="services section"><div class="section-heading"><div><p class="eyebrow">WHAT WE BRING TO YOUR OUTDOORS</p><h2>Beautiful spaces.<br/><em>Thoughtfully made.</em></h2></div><a class="under-link" href="/services/">Explore our services ↗</a></div><p class="section-summary">A garden with character. A patio with purpose. An outdoor room that feels like home. Discover three ways to shape the spaces beyond your door.</p><div class="service-grid">{services.map((s,i)=><a class="service-card" href={`/services/#${s.id}`}><Photo name={s.image} alt={s.alt}/><div class="service-card-copy"><span>0{i+1}</span><h3>{s.title}</h3><span aria-hidden="true">↗</span></div></a>)}</div></section>
<section class="section selected"><div class="section-heading"><div><p class="eyebrow">A FEW POSSIBILITIES</p><h2>Spaces with <em>a sense of place.</em></h2></div><a class="under-link" href="/projects/">View all concepts ↗</a></div><p class="section-note">Concept portfolio only. These imagined project stories feature licensed photography, not real completed commissions.</p><ProjectGrid/></section>
<BeforeAfter/>
<section class="approach section"><div><p class="eyebrow">FROM FIRST THOUGHT TO FINAL DETAIL</p><h2>A clear path to<br/><em>your kind of outdoors.</em></h2><a class="under-link" href="/about/">The design-build approach ↗</a></div><ol class="steps"><li><span>01</span><div><h3>Listen & discover</h3><p>Start with your vision, your space, and what you want to feel when you step outside.</p></div></li><li><span>02</span><div><h3>Design with intention</h3><p>Bring the layout, materials, planting, and practical details into one considered plan.</p></div></li><li><span>03</span><div><h3>Bring it together</h3><p>A clear scope and thoughtful sequence turn a promising concept into a place to enjoy.</p></div></li></ol></section>
<CTA title="What could your outdoors become?" text="Take a look at the sample estimate experience. This is a portfolio demonstration — no inquiry is sent."/>
</Layout>
