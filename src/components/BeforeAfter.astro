<section class="comparison-section section"><div class="section-heading"><div><p class="eyebrow">THE POSSIBILITIES, REIMAGINED</p><h2>A fresh perspective.<br/><em>A different feeling.</em></h2></div><p>Explore a conceptual before & after. Drag the handle or use the arrow keys to reveal the design.</p></div><div class="comparison" style="--split:50%"><img class="compare-base" src="/images/after.svg" alt="Illustrated garden concept with stone terrace, planted borders, and a seating area" width="1600" height="900" loading="lazy"/><div class="compare-before"><img src="/images/before.svg" alt="Illustrated starting concept with a bare lawn and plain boundary" width="1600" height="900" loading="lazy"/></div><span class="compare-label before-label">BEFORE · ILLUSTRATION</span><span class="compare-label after-label">AFTER · CONCEPT</span><div class="compare-line" aria-hidden="true"><span>↔</span></div></div><label class="range-label" for="comparison-range">Before / after reveal <output id="reveal-output">50% after</output></label><input id="comparison-range" type="range" min="0" max="100" value="50" aria-label="Reveal after garden design" aria-describedby="comparison-note"/><p id="comparison-note" class="caption">Original illustrations by SPR Web Studio. An imagined transformation, not a real completed project.</p></section>
<script>
const range=document.querySelector<HTMLInputElement>('#comparison-range');
const comparison=document.querySelector<HTMLElement>('.comparison');
range?.addEventListener('input',()=>{comparison?.style.setProperty('--split',`${100-Number(range.value)}%`); const output=document.querySelector('output');if(output)output.textContent=`${range.value}% after`;});
if(comparison&&range){const update=(event:PointerEvent)=>{const rect=comparison.getBoundingClientRect();range.value=String(Math.round(100-Math.max(0,Math.min(100,(event.clientX-rect.left)/rect.width*100))));range.dispatchEvent(new Event('input'));};comparison.addEventListener('pointerdown',e=>{comparison.setPointerCapture(e.pointerId);update(e);});comparison.addEventListener('pointermove',e=>{if(comparison.hasPointerCapture(e.pointerId))update(e);});}
</script>
